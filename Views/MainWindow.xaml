<ui:FluentWindow x:Class="ZenLoad.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title="ZenLoad"
                 Width="980"
                 Height="640"
                 MinWidth="800"
                 MinHeight="520"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="ZenLoad"
                     Icon="{ui:SymbolIcon Folder24}" />

        <Grid Grid.Row="1" Margin="26,12,26,8">
            <StackPanel>
                <TextBlock FontSize="24"
                           FontWeight="SemiBold"
                           Text="Organiza tus Descargas" />
                <TextBlock Margin="0,3,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="ZenLoad aplica tus reglas automaticamente en segundo plano." />
            </StackPanel>
            <CheckBox HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                      Content="Iniciar con Windows" />
        </Grid>

        <TabControl Grid.Row="2" Margin="26,6,26,12">
            <TabItem Header="Reglas">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="Reglas de organizacion" />
                            <TextBlock Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Agrupa extensiones y elige la carpeta con Examinar." />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button Margin="6,0,0,0"
                                       Padding="13,6"
                                       Command="{Binding AddCommand}"
                                       Content="Agregar" />
                            <ui:Button Margin="6,0,0,0"
                                       Padding="13,6"
                                       Command="{Binding RemoveCommand}"
                                       Content="Eliminar" />
                        </StackPanel>
                    </DockPanel>

                    <ui:Card Grid.Row="1" Padding="10">
                        <DataGrid AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  ItemsSource="{Binding Rules}"
                                  SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Width="70"
                                                        Header="Activa"
                                                        Binding="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Width="250"
                                                    Header="Extensiones"
                                                    Binding="{Binding Extension, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTemplateColumn Width="*" Header="Carpeta de destino">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel LastChildFill="True">
                                                <ui:Button DockPanel.Dock="Right"
                                                           Margin="8,2,0,2"
                                                           Padding="11,5"
                                                           Command="{Binding DataContext.BrowseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                           CommandParameter="{Binding}"
                                                           Content="Examinar" />
                                                <TextBox Margin="0,2"
                                                         VerticalContentAlignment="Center"
                                                         Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ui:Card>

                    <TextBlock Grid.Row="2"
                               Margin="2,8,2,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Ejemplo: .doc, .docx, .xls"
                               TextWrapping="Wrap" />
                </Grid>
            </TabItem>

            <TabItem Header="Actividad">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Margin="0,0,0,8"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Text="Actividad reciente" />
                    <ui:Card Grid.Row="1" Padding="10">
                        <DataGrid AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding RecentActivity}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="75" Header="Hora" Binding="{Binding TimeText}" />
                                <DataGridTextColumn Width="150" Header="Estado" Binding="{Binding StatusText}" />
                                <DataGridTextColumn Width="230" Header="Archivo" Binding="{Binding FileName}" />
                                <DataGridTextColumn Width="*" Header="Detalles" Binding="{Binding Details}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </ui:Card>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="3" Margin="26,0,26,12">
            <TextBlock Margin="2,0,2,8"
                       Foreground="#C50F1F"
                       Text="{Binding RouteValidationMessage}"
                       TextWrapping="Wrap" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button Margin="0,0,8,0"
                           Padding="18,8"
                           Command="{Binding TogglePauseCommand}"
                           Content="{Binding PauseButtonText}" />
                <ui:Button Margin="0,0,8,0"
                           Padding="18,8"
                           Command="{Binding ResetCommand}"
                           Content="Restablecer" />
                <ui:Button Padding="18,8"
                           Command="{Binding SaveCommand}"
                           Content="Guardar reglas"
                           Appearance="Primary" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="4"
                Padding="26,8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <DockPanel>
                <Ellipse Width="9"
                         Height="9"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         Fill="#48C774" />
                <TextBlock VerticalAlignment="Center" Text="{Binding StatusMessage}" />
            </DockPanel>
        </Border>

        <ui:ContentDialogHost x:Name="RootContentDialogHost" Grid.RowSpan="5" />
    </Grid>
</ui:FluentWindow>
