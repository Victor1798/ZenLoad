<ui:FluentWindow x:Class="ZenLoad.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title="ZenLoad"
                 Width="1040"
                 Height="720"
                 MinWidth="760"
                 MinHeight="500"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="ZenLoad"
                     Icon="{ui:SymbolIcon Folder24}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,18,28,24">
                <TextBlock FontSize="30"
                           FontWeight="SemiBold"
                           Text="Organiza tus Descargas" />
                <TextBlock Margin="0,6,0,22"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="ZenLoad vigila tu carpeta de Descargas y aplica tus reglas automáticamente." />

                <ui:Card Padding="18">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Reglas de organización" />
                                <TextBlock Margin="0,3,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="Usa rutas absolutas o carpetas relativas a Descargas." />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ui:Button Margin="6,0,0,0"
                                           Padding="14,7"
                                           Command="{Binding AddCommand}"
                                           Content="Agregar" />
                                <ui:Button Margin="6,0,0,0"
                                           Padding="14,7"
                                           Command="{Binding RemoveCommand}"
                                           Content="Eliminar" />
                            </StackPanel>
                        </DockPanel>

                                <DataGrid MinHeight="360"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  ItemsSource="{Binding Rules}"
                                  SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="260"
                                                    Header="Extensiones"
                                                    Binding="{Binding Extension, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTemplateColumn Width="*" Header="Carpeta de destino">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel LastChildFill="True">
                                                <ui:Button DockPanel.Dock="Right"
                                                           Margin="8,2,0,2"
                                                           Padding="12,5"
                                                           Command="{Binding DataContext.BrowseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                           CommandParameter="{Binding}"
                                                           Content="Examinar" />
                                                <TextBox Margin="0,2"
                                                         VerticalContentAlignment="Center"
                                                         Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Margin="2,10,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Puedes agrupar extensiones con comas, por ejemplo: .doc, .docx, .xls" />
                    </StackPanel>
                </ui:Card>

                <TextBlock Margin="4,12,4,0"
                           Foreground="#C50F1F"
                           Text="{Binding RouteValidationMessage}"
                           TextWrapping="Wrap" />

                <ui:Card Margin="0,18,0,0" Padding="18">
                    <Expander Header="Actividad reciente" IsExpanded="True">
                        <DataGrid Height="175"
                                  Margin="0,12,0,0"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding RecentActivity}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="75" Header="Hora" Binding="{Binding TimeText}" />
                                <DataGridTextColumn Width="170" Header="Estado" Binding="{Binding StatusText}" />
                                <DataGridTextColumn Width="220" Header="Archivo" Binding="{Binding FileName}" />
                                <DataGridTextColumn Width="*" Header="Detalles" Binding="{Binding Details}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Expander>
                </ui:Card>

                <StackPanel Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox Margin="0,0,24,0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                              Content="Iniciar con Windows" />
                    <ui:Button Margin="0,0,10,0"
                               Padding="22,10"
                               Command="{Binding TogglePauseCommand}"
                               Content="{Binding PauseButtonText}" />
                    <ui:Button Margin="0,0,10,0"
                               Padding="22,10"
                               Command="{Binding ResetCommand}"
                               Content="Restablecer" />
                    <ui:Button Padding="22,10"
                               Command="{Binding SaveCommand}"
                               Content="Guardar reglas"
                               Appearance="Primary" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="28,10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <DockPanel>
                <Ellipse Width="9"
                         Height="9"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         Fill="#48C774" />
                <TextBlock VerticalAlignment="Center" Text="{Binding StatusMessage}" />
            </DockPanel>
        </Border>

        <ui:ContentDialogHost x:Name="RootContentDialogHost" Grid.RowSpan="3" />
    </Grid>
</ui:FluentWindow>
