<Application x:Class="ZenLoad.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <DrawingImage x:Key="ZenLoadTrayIcon">
                <DrawingImage.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#0078D4"
                                         Geometry="M 1,3 L 7,3 L 9,5 L 15,5 L 15,14 L 1,14 Z" />
                        <GeometryDrawing Brush="#FFFFFF"
                                         Geometry="M 4,8 L 12,8 L 12,9 L 4,9 Z" />
                        <GeometryDrawing Brush="#FFFFFF"
                                         Geometry="M 7.5,7 L 8.5,7 L 8.5,11 L 7.5,11 Z" />
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
